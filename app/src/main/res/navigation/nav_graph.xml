<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.yourteam.shareplate.ui.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_splashFragment"
            app:destination="@id/splashFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.yourteam.shareplate.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_homeFeedFragment"
            app:destination="@id/homeFeedFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.yourteam.shareplate.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFeedFragment"
            app:destination="@id/homeFeedFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFeedFragment"
        android:name="com.yourteam.shareplate.ui.HomeFeedFragment"
        android:label="Home Feed"
        tools:layout="@layout/fragment_home_feed">
        <action
            android:id="@+id/action_homeFeedFragment_to_listingDetailsFragment"
            app:destination="@id/listingDetailsFragment" />
        <action
            android:id="@+id/action_homeFeedFragment_to_createListingFragment"
            app:destination="@id/createListingFragment" />
        <action
            android:id="@+id/action_homeFeedFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_homeFeedFragment_to_shareBotFragment"
            app:destination="@id/shareBotFragment" />
        <action
            android:id="@+id/action_homeFeedFragment_to_impactDashboardFragment"
            app:destination="@id/impactDashboardFragment" />
        <action
            android:id="@+id/action_homeFeedFragment_to_profileSettingsFragment"
            app:destination="@id/profileSettingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/listingDetailsFragment"
        android:name="com.yourteam.shareplate.ui.ListingDetailsFragment"
        android:label="Listing Details"
        tools:layout="@layout/fragment_listing_details">
        <action
            android:id="@+id/action_listingDetailsFragment_to_reservationConfirmationFragment"
            app:destination="@id/reservationConfirmationFragment" />
        <action
            android:id="@+id/action_listingDetailsFragment_to_pickupPassFragment"
            app:destination="@id/pickupPassFragment" />
    </fragment>

    <fragment
        android:id="@+id/createListingFragment"
        android:name="com.yourteam.shareplate.ui.CreateListingFragment"
        android:label="Create Listing"
        tools:layout="@layout/fragment_create_listing">
        <action
            android:id="@+id/action_createListingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/reservationConfirmationFragment"
        android:name="com.yourteam.shareplate.ui.ReservationConfirmationFragment"
        android:label="Reservation Confirmation"
        tools:layout="@layout/fragment_reservation_confirmation">
        <action
            android:id="@+id/action_reservationConfirmationFragment_to_pickupPassFragment"
            app:destination="@id/pickupPassFragment"
            app:popUpTo="@id/homeFeedFragment" />
    </fragment>

    <fragment
        android:id="@+id/pickupPassFragment"
        android:name="com.yourteam.shareplate.ui.PickupPassFragment"
        android:label="Pickup Pass"
        tools:layout="@layout/fragment_pickup_pass">
        <action
            android:id="@+id/action_pickupPassFragment_to_homeFeedFragment"
            app:destination="@id/homeFeedFragment"
            app:popUpTo="@id/homeFeedFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/providerScanFragment"
        android:name="com.yourteam.shareplate.ui.ProviderScanFragment"
        android:label="Scan Pickup"
        tools:layout="@layout/fragment_provider_scan" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.yourteam.shareplate.ui.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/shareBotFragment"
        android:name="com.yourteam.shareplate.ui.ShareBotFragment"
        android:label="ShareBot AI Assistant"
        tools:layout="@layout/fragment_share_bot" />

    <fragment
        android:id="@+id/myReservationsFragment"
        android:name="com.yourteam.shareplate.ui.MyReservationsFragment"
        android:label="My Reservations"
        tools:layout="@layout/fragment_my_reservations">
        <action
            android:id="@+id/action_myReservationsFragment_to_pickupPassFragment"
            app:destination="@id/pickupPassFragment" />
    </fragment>

    <fragment
        android:id="@+id/impactDashboardFragment"
        android:name="com.yourteam.shareplate.ui.ImpactDashboardFragment"
        android:label="Impact Dashboard"
        tools:layout="@layout/fragment_impact_dashboard">
        <action
            android:id="@+id/action_impactDashboardFragment_to_leaderboardFragment"
            app:destination="@id/leaderboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.yourteam.shareplate.ui.LeaderboardFragment"
        android:label="Leaderboard"
        tools:layout="@layout/fragment_leaderboard" />

    <fragment
        android:id="@+id/profileSettingsFragment"
        android:name="com.yourteam.shareplate.ui.ProfileSettingsFragment"
        android:label="Profile &amp; Settings"
        tools:layout="@layout/fragment_profile_settings">
        <action
            android:id="@+id/action_profileSettingsFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
